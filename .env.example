# true (default) = local simulator; false = connect to the FastAPI gateway
VITE_USE_MOCK=true
# Gateway WebSocket that streams StreamMessage JSON (see README)
VITE_WS_URL=ws://localhost:8000/ws
# Gateway REST base for demo triggers + authority actions
VITE_API_URL=http://localhost:8000
# MST block explorer base, used for /tx/<hash> and /address/<addr> links
VITE_EXPLORER_URL=https://explorer.testnet.mst.example
# Deployed contract addresses (leave blank to show placeholders)
VITE_ADDR_SENSOR_REGISTRY=
VITE_ADDR_CORROBORATION_ENGINE=
VITE_ADDR_REPUTATION_MANAGER=
VITE_ADDR_TASK_MARKET=
VITE_ADDR_EVIDENCE_LOG=
